{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "tsx --env-file-if-exists=../../.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "tsx --env-file-if-exists=../../.env node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.115.0",
    "cors": "^2.8.5",
    "drizzle-orm": "0.45.2",
    "express": "^5.1.0",
    "jose": "6.2.11",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "drizzle-kit": "0.31.10",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2"
  }
}
