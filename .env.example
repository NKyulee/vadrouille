# Copier en .env à la racine. Le .env réel n'est pas versionné.
#
# Toutes ces valeurs viennent du tableau de bord Supabase :
#   Project Settings › API        pour l'URL et les clés
#   Project Settings › Database   pour la chaîne de connexion

# --- Côté serveur (apps/api) ------------------------------------------------

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique. Elle respecte le RLS : c'est celle qu'on utilise au nom d'un
# utilisateur, et la seule qui ait le droit d'aller jusqu'au navigateur.
SUPABASE_ANON_KEY=

# SECRET. Contourne entièrement le RLS : quiconque l'obtient lit et écrit
# toute la base. Jamais dans le front, jamais dans un dépôt, jamais dans un
# log. Sert uniquement aux opérations d'administration côté serveur.
SUPABASE_SERVICE_ROLE_KEY=

# Connexion directe, pour les migrations Drizzle uniquement.
# Onglet Database › Connection string › URI (penser à remplacer [YOUR-PASSWORD]).
DATABASE_URL=

# Origine autorisée à appeler l'API.
WEB_ORIGIN=http://localhost:5173

# Facultatif : mot de passe du compte professionnel de démonstration créé par
# `pnpm --filter api db:seed`. Sans lui, un mot de passe est tiré au hasard et
# affiché une seule fois, à la création.
SEED_PRO_PASSWORD=

# --- Côté navigateur (apps/web) ---------------------------------------------
# Préfixe VITE_ obligatoire : sans lui, Vite n'expose pas la variable.
# Ces deux valeurs se retrouvent dans le bundle — donc jamais autre chose
# que l'URL et la clé anonyme ici.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3000
